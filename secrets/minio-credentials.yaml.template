# MinIO root credentials for the official MinIO chart.
# Fill in both values, then run: kubectl apply -f secrets/minio-credentials.yaml
# Use the same rootPassword in s3-secret.yaml.template.
apiVersion: v1
kind: Secret
metadata:
  name: minio-credentials
  namespace: minio
type: Opaque
stringData:
  rootUser: speckle
  rootPassword: "REPLACE_WITH_MINIO_ROOT_PASSWORD"
